# Senpai's Bot - Environment Configuration
# Copy this file to .env and fill in your values

# --- Telegram Bot ---
# Get a bot token from @BotFather on Telegram
BOT_TOKEN=

# Your personal Telegram user ID (the bot owner/superadmin)
# Send /start to @userinfobot on Telegram to get your ID
OWNER_ID=

# --- GitHub (Optional but Recommended) ---
# Personal Access Token for higher API rate limits (5000/hr vs 60/hr)
# Create at: https://github.com/settings/tokens
# Permissions needed: read-only access to public repos
GITHUB_TOKEN=

# How often to check for new commits (in minutes, default: 5)
COMMIT_POLL_INTERVAL=5

# --- Database ---
# Path to SQLite database file (default: data/bot.db)
# DB_PATH=data/bot.db

# --- Logging ---
# Options: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- Feature Toggles ---
# Set to false to disable entire feature groups
ENABLE_COMMIT_TRACKER=true
ENABLE_GROUP_MANAGEMENT=true
